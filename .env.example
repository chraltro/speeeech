# OpenAI API Configuration
# Required for Whisper transcription and TTS
# Get your API key from: https://platform.openai.com/api-keys
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration  
# Required for AI text generation and post-processing
# Get your API key from: https://aistudio.google.com/app/apikey
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# AssemblyAI API Configuration
# Required for speaker diarization (identifying multiple speakers)
# Get your API key from: https://www.assemblyai.com/app/
REACT_APP_ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Insanely Fast Whisper Backend (Optional but Recommended)
# For best speaker diarization, run the Python backend
# See backend/README.md for setup instructions
REACT_APP_WHISPER_BACKEND_URL=http://localhost:8000

# Firebase Configuration (if using session storage)
# Optional - only needed if you want to save conversations
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Development Settings
# Set to false in production
REACT_APP_DEBUG_MODE=true